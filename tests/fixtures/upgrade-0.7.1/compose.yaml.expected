services:
  unifi-fabric-mcp:
    image: ghcr.io/swkstudios/unifi-fabric-mcp-server:0.7.0
    env_file: unifi.env
    environment:
      - UNIFI_API_KEY=${UNIFI_API_KEY}
      - "UNIFI_WRITE_POLICY=deny"
      - "UNIFI_WRITE_EXCEPTIONS=family:vpn=deny;family:network=deny"
      # MANUAL: UNIFI_DISABLE_API_SOURCES names a selector 0.7.1 does not accept, such as app/source/access; see https://github.com/swkstudios/unifi-fabric-mcp-server/blob/v0.7.1/docs/MIGRATING-0.7.1.md
      - UNIFI_DISABLE_API_SOURCES=network/private/write
    ports:
      - "8000:8000"

  unifi-fabric-mcp-protect:
    image: ghcr.io/swkstudios/unifi-fabric-mcp-server:0.7.0
    environment:
      UNIFI_API_KEY: ${UNIFI_API_KEY}
      UNIFI_WRITE_EXCEPTIONS: "family:protect=deny"
      UNIFI_FAMILY_ALLOW: "protect"
      UNIFI_TOOL_MODE: full
