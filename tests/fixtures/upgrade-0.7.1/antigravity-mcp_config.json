{
  "mcpServers": {
    "unifi-fabric": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "-e", "UNIFI_API_KEY",
        "-e", "UNIFI_READ_ONLY=1",
        "-e", "UNIFI_ENABLE_CARRIER_FABRIC_WRITE=0",
        "-e", "FASTMCP_TRANSPORT=stdio",
        "ghcr.io/swkstudios/unifi-fabric-mcp-server:0.7.0"
      ]
    }
  }
}
