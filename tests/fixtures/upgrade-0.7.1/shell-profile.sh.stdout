== shell-profile.sh (shell)
export lines:
  - UNIFI_READ_ONLY
  - UNIFI_TOOL_FAMILIES
  + UNIFI_WRITE_POLICY=deny
  + UNIFI_FAMILY_ALLOW=network,protect
  replace the removed export lines with:
  export UNIFI_WRITE_POLICY=deny
  export UNIFI_FAMILY_ALLOW=network,protect
line 6: -e flags:
  - UNIFI_DRY_RUN
  - UNIFI_ENABLE_CONNECTOR_WRITE
  + UNIFI_WRITE_POLICY=dry-run
  + UNIFI_WRITE_EXCEPTIONS=family:connector=deny
  replace the removed -e flags with: -e UNIFI_WRITE_POLICY=dry-run -e UNIFI_WRITE_EXCEPTIONS=family:connector=deny
