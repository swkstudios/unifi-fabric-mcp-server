{
  "mcpServers": {
    "unifi-fabric": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "UNIFI_API_KEY",
        "-e",
        "UNIFI_WRITE_POLICY=deny",
        "-e",
        "UNIFI_WRITE_EXCEPTIONS=family:carrier=deny",
        "-e",
        "FASTMCP_TRANSPORT=stdio",
        "ghcr.io/swkstudios/unifi-fabric-mcp-server:0.7.0"
      ]
    }
  }
}
