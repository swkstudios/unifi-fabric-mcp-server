{
    "mcpServers": {
        "unifi-fabric": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "--from",
                "unifi-fabric-mcp-server==0.7.0",
                "unifi-fabric-mcp"
            ],
            "env": {
                "UNIFI_API_KEY": "your-api-key-here",
                "UNIFI_WRITE_POLICY": "dry-run",
                "UNIFI_EXCLUDE": "family:vpn,family:hotspot,source:network/private.classic,source:protect/private"
            }
        }
    }
}
