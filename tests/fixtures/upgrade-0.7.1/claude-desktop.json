{
  "mcpServers": {
    "unifi-fabric": {
      "command": "/absolute/path/to/uvx",
      "args": ["--from", "unifi-fabric-mcp-server==0.7.0", "unifi-fabric-mcp"],
      "env": {
        "UNIFI_API_KEY": "your-api-key-here",
        "UNIFI_READ_ONLY": "1",
        "UNIFI_ENABLE_NETWORK_WRITE": "0",
        "UNIFI_PROTECT_MUTATIONS_ENABLED": "false",
        "UNIFI_TOOL_FAMILIES": "Network PROTECT, firewall",
        "UNIFI_TOOL_MODE": "full"
      }
    }
  }
}
