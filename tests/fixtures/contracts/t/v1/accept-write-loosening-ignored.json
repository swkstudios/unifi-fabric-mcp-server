{
  "schema_version": "1",
  "contract": "t",
  "name": "accept-write-loosening-ignored",
  "description": "A request allow under an operator deny is ignored loosening: the policy stays deny",
  "kind": "accept",
  "input": {
    "env": {
      "UNIFI_API_KEY": "synthetic-key-a",
      "UNIFI_WRITE_POLICY": "deny",
      "UNIFI_TOOL_MODE": "full"
    },
    "headers": [
      [
        "X-UniFi-Write-Policy",
        "allow"
      ]
    ],
    "route": "tools/list"
  },
  "expected": {
    "effective_policy": {
      "write_policy": "deny",
      "write_exceptions": [],
      "exposed_families": [
        "carrier",
        "clients",
        "connector",
        "devices",
        "firewall",
        "hotspot",
        "innerspace",
        "mobility",
        "network",
        "protect",
        "site_manager",
        "statistics",
        "vpn"
      ],
      "exclusions": []
    },
    "ignored_loosening": [
      "x-unifi-write-policy=allow"
    ],
    "upstream_calls": 0
  }
}
