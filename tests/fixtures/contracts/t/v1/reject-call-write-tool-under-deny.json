      "UNIFI_API_KEY": "synthetic-key-a",
      "UNIFI_WRITE_POLICY": "deny"
    },
    "route": "call_write_tool",
    "arguments": {
      "name": "create_network",
      "arguments": {
        "host": "host-a1",
        "site": "default",
        "network_config": {
          "name": "synthetic-net"
        }
      }
    }
  },
  "expected": {
    "code": "write_denied",
    "upstream_calls": 0
  }
}
