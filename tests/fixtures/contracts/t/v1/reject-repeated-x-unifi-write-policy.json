      "UNIFI_API_KEY": "synthetic-key-a",
      "UNIFI_TOOL_MODE": "full"
    },
    "headers": [
      [
        "X-UniFi-Write-Policy",
        "deny"
      ],
      [
        "X-UniFi-Write-Policy",
        "dry-run"
      ]
    ],
    "route": "list_hosts",
    "arguments": {}
  },
  "expected": {
    "code": "invalid_policy_header",
    "upstream_calls": 0
  }
}
