{
  "schema_version": "1",
  "contract": "t",
  "name": "reject-exclude-header-meta-tool",
  "description": "X-UniFi-Exclude naming a meta tool (tool:search_tools) is an invalid target: invalid_policy_header",
  "kind": "reject",
  "input": {
    "env": {
      "UNIFI_API_KEY": "synthetic-key-a"
    },
    "headers": [
      [
        "X-UniFi-Exclude",
        "tool:search_tools"
      ]
    ],
    "route": "list_cameras",
    "arguments": {
      "host": "host-a1"
    }
  },
  "expected": {
    "code": "invalid_policy_header",
    "upstream_calls": 0
  }
}
