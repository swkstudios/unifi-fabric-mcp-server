{
  "schema_version": "1",
  "contract": "t",
  "name": "reject-deny-header-call-write-tool",
  "description": "A request deny header refuses a write dispatched through call_write_tool",
  "kind": "reject",
  "input": {
    "env": {
      "UNIFI_API_KEY": "synthetic-key-a"
    },
    "headers": [
      [
        "X-UniFi-Write-Policy",
        "deny"
      ]
    ],
    "route": "call_write_tool",
    "arguments": {
      "name": "create_network",
      "arguments": {
        "host": "host-a1",
        "site": "default",
        "network_config": {
          "name": "lab"
        }
      }
    }
  },
  "expected": {
    "code": "write_denied",
    "upstream_calls": 0
  }
}
