{
  "schema_version": "1",
  "contract": "t",
  "name": "reject-header-deny-under-operator-allow",
  "description": "X-UniFi-Write-Policy: deny tightens an allow operator: a write tool refuses with write_denied",
  "kind": "reject",
  "input": {
    "env": {
      "UNIFI_API_KEY": "synthetic-key-a",
      "UNIFI_TOOL_MODE": "full"
    },
    "headers": [
      [
        "X-UniFi-Write-Policy",
        "deny"
      ]
    ],
    "route": "create_network",
    "arguments": {
      "host": "host-a1",
      "site": "default",
      "network_config": {
        "name": "synthetic-net"
      }
    }
  },
  "expected": {
    "code": "write_denied",
    "upstream_calls": 0
  }
}
