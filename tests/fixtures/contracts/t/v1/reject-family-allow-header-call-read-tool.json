{
  "schema_version": "1",
  "contract": "t",
  "name": "reject-family-allow-header-call-read-tool",
  "description": "call_read_tool of a tool outside the request family set refuses with tool_not_exposed",
  "kind": "reject",
  "input": {
    "env": {
      "UNIFI_API_KEY": "synthetic-key-a"
    },
    "headers": [
      [
        "X-UniFi-Family-Allow",
        "network"
      ]
    ],
    "route": "call_read_tool",
    "arguments": {
      "name": "list_cameras",
      "arguments": {
        "host": "host-a1"
      }
    }
  },
  "expected": {
    "code": "tool_not_exposed",
    "upstream_calls": 0
  }
}
