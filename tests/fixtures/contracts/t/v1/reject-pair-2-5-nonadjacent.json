{
  "schema_version": "1",
  "contract": "t",
  "name": "reject-pair-2-5-nonadjacent",
  "description": "non-adjacent pair (2,5): a tool excluded by family:protect with the reserved X-UniFi-Family-Allow: meta refuses as invalid_policy_header",
  "kind": "reject",
  "input": {
    "env": {
      "UNIFI_API_KEY": "synthetic-key-a",
      "UNIFI_EXCLUDE": "family:protect",
      "UNIFI_TOOL_MODE": "full"
    },
    "headers": [
      [
        "X-UniFi-Family-Allow",
        "meta"
      ]
    ],
    "route": "list_cameras",
    "arguments": {}
  },
  "expected": {
    "code": "invalid_policy_header",
    "upstream_calls": 0
  }
}
