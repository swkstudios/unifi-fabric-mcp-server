{
  "schema_version": "1",
  "contract": "h",
  "name": "reject-call-read-tool-nested-key-label",
  "description": "Header mode refuses key_label inside a discovery call_read_tool's dispatched arguments",
  "kind": "reject",
  "input": {
    "env": {
      "UNIFI_KEY_MODE": "header"
    },
    "headers": [
      [
        "X-UniFi-Api-Key",
        "{\"alpha\":\"synthetic-key-a\"}"
      ]
    ],
    "route": "call_read_tool",
    "arguments": {
      "name": "list_hosts",
      "arguments": {
        "key_label": "alpha"
      }
    }
  },
  "expected": {
    "code": "key_label_not_allowed",
    "upstream_calls": 0
  }
}
