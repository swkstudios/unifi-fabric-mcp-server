{
  "schema_version": "1",
  "contract": "h",
  "name": "reject-malformed-header-not-json",
  "description": "An X-UniFi-Api-Key value that is not JSON is invalid",
  "kind": "reject",
  "input": {
    "env": {
      "UNIFI_KEY_MODE": "header",
      "UNIFI_TOOL_MODE": "full"
    },
    "headers": [
      [
        "X-UniFi-Api-Key",
        "not-json"
      ]
    ],
    "route": "list_hosts",
    "arguments": {}
  },
  "expected": {
    "code": "invalid_api_key_header",
    "upstream_calls": 0
  }
}
