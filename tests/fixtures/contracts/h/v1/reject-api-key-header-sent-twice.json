{
  "schema_version": "1",
  "contract": "h",
  "name": "reject-api-key-header-sent-twice",
  "description": "X-UniFi-Api-Key sent twice is invalid",
  "kind": "reject",
  "input": {
    "env": {
      "UNIFI_KEY_MODE": "header",
      "UNIFI_TOOL_MODE": "full"
    },
    "headers": [
      [
        "X-UniFi-Api-Key",
        "{\"alpha\":\"synthetic-key-a\"}"
      ],
      [
        "X-UniFi-Api-Key",
        "{\"beta\":\"synthetic-key-b\"}"
      ]
    ],
    "route": "list_hosts",
    "arguments": {}
  },
  "expected": {
    "code": "invalid_api_key_header",
    "upstream_calls": 0
  }
}
