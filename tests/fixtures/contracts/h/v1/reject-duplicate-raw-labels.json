{
  "schema_version": "1",
  "contract": "h",
  "name": "reject-duplicate-raw-labels",
  "description": "An X-UniFi-Api-Key object that repeats a label is invalid",
  "kind": "reject",
  "input": {
    "env": {
      "UNIFI_KEY_MODE": "header",
      "UNIFI_TOOL_MODE": "full"
    },
    "headers": [
      [
        "X-UniFi-Api-Key",
        "{\"alpha\":\"synthetic-key-a\",\"alpha\":\"synthetic-key-b\"}"
      ]
    ],
    "route": "list_hosts",
    "arguments": {}
  },
  "expected": {
    "code": "invalid_api_key_header",
    "upstream_calls": 0
  }
}
